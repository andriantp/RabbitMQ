# Salin ke .env lalu muat ke shell: cp .env.example .env && source .env

# URL koneksi AMQP (amqp://user:pass@host:port/vhost)
export RABBITMQ_HOST="amqp://guest:guest@localhost:5672/"

# Exchange: tipe bisa direct | topic | fanout | headers
export RABBITMQ_EXCHANGE="app"
export RABBITMQ_EXCHANGE_TYPE="topic"

export RABBITMQ_QUEUE="app-test"

# Topic memakai pemisah titik (.), wildcard: * = satu segmen, # = nol/lebih segmen
export RABBITMQ_BINDING_KEY="app.#"                 # consumer (QueueBind): pattern
export RABBITMQ_ROUTING_KEY="app.v1.order.created"  # producer (Publish): key konkret

# Consumer & producer: maks percobaan reconnect berturut-turut sebelum exit (default 5)
export RABBITMQ_MAX_RETRIES="5"

# Consumer: retry queue ber-TTL untuk error sementara (opsional)
# Mengubah RETRY_DELAY setelah queue <queue>.retry dibuat -> PRECONDITION_FAILED; hapus queue retry dulu
export RABBITMQ_RETRY_MAX="3"       # maks retry sebelum ke DLQ (default 3)
export RABBITMQ_RETRY_DELAY="10s"   # jeda antar percobaan, format durasi Go (default 10s)
